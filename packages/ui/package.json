{
  "name": "@meonode/ui",
  "description": "A structured approach to component composition, direct CSS-first prop styling, built-in theming, smart prop handling (including raw property pass-through), and dynamic children.",
  "version": "3.1.5",
  "type": "module",
  "main": "./dist/cjs/main.cjs",
  "module": "./dist/esm/main.js",
  "types": "./dist/types/main.d.cts",
  "typesVersions": {
    "*": {
      "client": [
        "./dist/types/client.d.cts"
      ],
      "nextjs-registry": [
        "./dist/types/nextjs-registry/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-server": {
        "import": {
          "types": "./dist/types/main.d.ts",
          "default": "./dist/rsc/esm/main.js"
        },
        "require": {
          "types": "./dist/types/main.d.cts",
          "default": "./dist/rsc/cjs/main.cjs"
        }
      },
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/esm/main.js"
      },
      "require": {
        "types": "./dist/types/main.d.cts",
        "default": "./dist/cjs/main.cjs"
      }
    },
    "./client": {
      "react-server": {
        "import": {
          "types": "./dist/types/client.d.ts",
          "default": "./dist/rsc/esm/client.js"
        },
        "require": {
          "types": "./dist/types/client.d.cts",
          "default": "./dist/rsc/cjs/client.cjs"
        }
      },
      "import": {
        "types": "./dist/types/client.d.ts",
        "default": "./dist/esm/client.js"
      },
      "require": {
        "types": "./dist/types/client.d.cts",
        "default": "./dist/cjs/client.cjs"
      }
    },
    "./nextjs-registry": {
      "react-server": {
        "import": {
          "types": "./dist/types/nextjs-registry/index.d.ts",
          "default": "./dist/rsc/esm/nextjs-registry/index.js"
        },
        "require": {
          "types": "./dist/types/nextjs-registry/index.d.cts",
          "default": "./dist/rsc/cjs/nextjs-registry/index.cjs"
        }
      },
      "import": {
        "types": "./dist/types/nextjs-registry/index.d.ts",
        "default": "./dist/esm/nextjs-registry/index.js"
      },
      "require": {
        "types": "./dist/types/nextjs-registry/index.d.cts",
        "default": "./dist/cjs/nextjs-registry/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "watch:build": "bunx nodemon --watch src --ext ts,tsx,js,json --exec \"bun run build\"",
    "lint": "eslint --fix && tsc --noEmit && bun run typecheck:augmented",
    "typecheck:augmented": "tsc -p tests/augmented/tsconfig.json",
    "test": "NODE_OPTIONS='--expose-gc' node --stack-size=10000 --max-old-space-size=8192 \"$(node scripts/vitest-entry.mjs)\" run --config vitest.config.ts --exclude tests/rsc-integration.test.ts --exclude tests/rsc-build.test.ts --exclude tests/rsc-theme-script.test.ts --exclude tests/rsc-theme-flicker.test.ts --exclude tests/build-output.test.ts --exclude tests/theme-length-browser.test.ts --exclude tests/dev-mode-environments.test.ts",
    "test:rsc": "NODE_OPTIONS='--experimental-vm-modules' vitest run --config vitest.integration.config.ts",
    "prepare:rsc-fixture": "cd tests/rsc-fixtures/next-app && bun install && cd ../next-build && bun install",
    "verify": "bun run prepare:rsc-fixture && bun run lint && bun run tsc --noEmit && bun run test && bun run test:compiled && bun run test:rsc && bun run test:rsc:compiled",
    "build": "rm -rf ./dist && rollup -c rollup.config.ts --configPlugin 'typescript={tsconfig:\"./tsconfig.rollup-config.json\"}' && tsc -p tsconfig.build.json --diagnostics && tsc-alias -p tsconfig.build.json && bun ../../scripts/emit-cjs-declarations.ts dist/types",
    "export:css-props": "bun scripts/export-css-properties.ts",
    "test:compiled": "NODE_OPTIONS='--expose-gc' node --stack-size=10000 --max-old-space-size=8192 \"$(node scripts/vitest-entry.mjs)\" run --config vitest.compiled.config.ts --exclude tests/rsc-integration.test.ts --exclude tests/rsc-build.test.ts --exclude tests/rsc-theme-script.test.ts --exclude tests/rsc-theme-flicker.test.ts --exclude tests/build-output.test.ts --exclude tests/theme-length-browser.test.ts --exclude tests/dev-mode-environments.test.ts",
    "test:flight": "vitest run --config vitest.flight.config.ts && NODE_ENV=production vitest run --config vitest.flight.config.ts",
    "test:rsc:compiled": "MEONODE_COMPILED=1 NODE_OPTIONS='--experimental-vm-modules' vitest run --config vitest.integration.config.ts",
    "test:rsc:build": "NODE_OPTIONS='--experimental-vm-modules' vitest run --config vitest.build.config.ts",
    "test:rsc:build:compiled": "MEONODE_COMPILED=1 NODE_OPTIONS='--experimental-vm-modules' vitest run --config vitest.build.config.ts",
    "bench": "NODE_ENV=production node --expose-gc --stack-size=10000 bench/node-construction.mjs && NODE_ENV=production node --expose-gc --stack-size=10000 bench/client-render.mjs && NODE_ENV=production node --expose-gc --stack-size=10000 bench/large-trees.mjs && NODE_ENV=production node --expose-gc --stack-size=10000 bench/react-comparison.mjs && NODE_ENV=production node --expose-gc --stack-size=10000 bench/memory.mjs",
    "export:css-props:length": "bun scripts/export-css-properties.ts --length"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/serialize": "^1.3.3",
    "@emotion/unitless": "^0.10.0",
    "@emotion/utils": "^1.4.2",
    "stylis": "^4.4.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/jest": "^11.14.2",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@meonode/compiler": "^0.10.1",
    "@mui/material": "^9.5.0",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@swc/core": "^1.16.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cli-table3": "^0.6.5",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "next": "^16.4.6",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-server-dom-turbopack": "^19.3.1",
    "rollup": "^4.68.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tsc-alias": "1.9.10",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "whatwg-fetch": "^3.6.20"
  },
  "peerDependencies": {
    "@emotion/cache": ">=11.14.0",
    "@emotion/react": ">=11.14.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meonode.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.meonode.com",
  "bugs": {
    "url": "https://github.com/l7aromeo/meonode/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "ui-framework",
    "theme-engine",
    "jsx-free",
    "type-safe",
    "component-composition",
    "css-in-js",
    "design-system",
    "react-components",
    "dynamic-theming",
    "frontend",
    "web-development",
    "no-jsx",
    "component-library",
    "accessible-components",
    "meonode-ui",
    "meonode"
  ]
}
