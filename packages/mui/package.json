{
  "name": "@meonode/mui",
  "version": "3.1.0",
  "description": "A lightweight wrapper around `@mui/material` components for use with `@meonode/ui` and the BaseNode runtime.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meonode.git",
    "directory": "packages/mui"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meonode/issues"
  },
  "homepage": "https://ui.meonode.com/docs/mui-integration",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf ./dist && rollup -c rollup.config.ts --configPlugin typescript && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "generate:lib": "bun scripts/generate-wrapper-lib.js",
    "lint": "eslint --fix && tsc --noEmit && bun run typecheck:types",
    "typecheck:types": "tsc -p tests/types/tsconfig.json",
    "test:peer-floor": "bun install --cwd tests/peer-floor --frozen-lockfile && bun test tests/peer-floor.test.ts",
    "watch:build": "bunx concurrently \"bun run watch:core\" \"bun run watch:src\"",
    "watch:core": "bunx nodemon --watch $MEONODE/core/dist --ext ts,js,json --exec \"bun add -d @meonode/ui@file:$MEONODE/core\"",
    "watch:src": "bunx nodemon --watch src --ext ts,js,json --exec \"bun run build\""
  },
  "exports": {
    ".": {
      "import": "./dist/esm/main.js",
      "require": "./dist/cjs/main.cjs",
      "types": "./dist/types/main.d.ts"
    },
    "./nextjs13": {
      "import": "./dist/esm/lib/mui.nextjs13/index.js",
      "require": "./dist/cjs/lib/mui.nextjs13/index.cjs",
      "types": "./dist/types/lib/mui.nextjs13/index.d.ts"
    },
    "./nextjs14": {
      "import": "./dist/esm/lib/mui.nextjs14/index.js",
      "require": "./dist/cjs/lib/mui.nextjs14/index.cjs",
      "types": "./dist/types/lib/mui.nextjs14/index.d.ts"
    },
    "./nextjs15": {
      "import": "./dist/esm/lib/mui.nextjs15/index.js",
      "require": "./dist/cjs/lib/mui.nextjs15/index.cjs",
      "types": "./dist/types/lib/mui.nextjs15/index.d.ts"
    },
    "./nextjs16": {
      "import": "./dist/esm/lib/mui.nextjs16/index.js",
      "require": "./dist/cjs/lib/mui.nextjs16/index.cjs",
      "types": "./dist/types/lib/mui.nextjs16/index.d.ts"
    },
    "./lab": {
      "import": "./dist/esm/lib/mui.lab/index.js",
      "require": "./dist/cjs/lib/mui.lab/index.cjs",
      "types": "./dist/types/lib/mui.lab/index.d.ts"
    },
    "./x-data-grid": {
      "import": "./dist/esm/lib/mui.x-data-grid/index.js",
      "require": "./dist/cjs/lib/mui.x-data-grid/index.cjs",
      "types": "./dist/types/lib/mui.x-data-grid/index.d.ts"
    },
    "./x-data-grid-pro": {
      "import": "./dist/esm/lib/mui.x-data-grid-pro/index.js",
      "require": "./dist/cjs/lib/mui.x-data-grid-pro/index.cjs",
      "types": "./dist/types/lib/mui.x-data-grid-pro/index.d.ts"
    },
    "./x-data-grid-premium": {
      "import": "./dist/esm/lib/mui.x-data-grid-premium/index.js",
      "require": "./dist/cjs/lib/mui.x-data-grid-premium/index.cjs",
      "types": "./dist/types/lib/mui.x-data-grid-premium/index.d.ts"
    },
    "./x-date-pickers": {
      "import": "./dist/esm/lib/mui.x-date-pickers/index.js",
      "require": "./dist/cjs/lib/mui.x-date-pickers/index.cjs",
      "types": "./dist/types/lib/mui.x-date-pickers/index.d.ts"
    },
    "./x-date-pickers-pro": {
      "import": "./dist/esm/lib/mui.x-date-pickers-pro/index.js",
      "require": "./dist/cjs/lib/mui.x-date-pickers-pro/index.cjs",
      "types": "./dist/types/lib/mui.x-date-pickers-pro/index.d.ts"
    },
    "./x-tree-view": {
      "import": "./dist/esm/lib/mui.x-tree-view/index.js",
      "require": "./dist/cjs/lib/mui.x-tree-view/index.cjs",
      "types": "./dist/types/lib/mui.x-tree-view/index.d.ts"
    },
    "./x-tree-view-pro": {
      "import": "./dist/esm/lib/mui.x-tree-view-pro/index.js",
      "require": "./dist/cjs/lib/mui.x-tree-view-pro/index.cjs",
      "types": "./dist/types/lib/mui.x-tree-view-pro/index.d.ts"
    },
    "./x-charts": {
      "import": "./dist/esm/lib/mui.x-charts/index.js",
      "require": "./dist/cjs/lib/mui.x-charts/index.cjs",
      "types": "./dist/types/lib/mui.x-charts/index.d.ts"
    },
    "./x-charts-pro": {
      "import": "./dist/esm/lib/mui.x-charts-pro/index.js",
      "require": "./dist/cjs/lib/mui.x-charts-pro/index.cjs",
      "types": "./dist/types/lib/mui.x-charts-pro/index.d.ts"
    }
  },
  "peerDependencies": {
    "@meonode/ui": "^3.0.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-charts": "9.18.0",
    "@mui/x-charts-pro": "^9.18.0",
    "@mui/x-data-grid": "^9.18.0",
    "@mui/x-data-grid-premium": "^9.18.0",
    "@mui/x-data-grid-pro": "^9.18.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@mui/x-date-pickers-pro": "^9.18.0",
    "@mui/x-tree-view": "^9.18.0",
    "@mui/x-tree-view-pro": "^9.18.0",
    "react": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "@mui/lab": {
      "optional": true
    },
    "@mui/material-nextjs": {
      "optional": true
    },
    "@mui/x-charts": {
      "optional": true
    },
    "@mui/x-charts-pro": {
      "optional": true
    },
    "@mui/x-data-grid": {
      "optional": true
    },
    "@mui/x-data-grid-premium": {
      "optional": true
    },
    "@mui/x-data-grid-pro": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": true
    },
    "@mui/x-date-pickers-pro": {
      "optional": true
    },
    "@mui/x-tree-view": {
      "optional": true
    },
    "@mui/x-tree-view-pro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@meonode/ui": "^3.1.5",
    "@mui/lab": "^9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-charts": "9.18.0",
    "@mui/x-charts-pro": "^9.18.0",
    "@mui/x-data-grid": "^9.18.0",
    "@mui/x-data-grid-premium": "^9.18.0",
    "@mui/x-data-grid-pro": "^9.18.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@mui/x-date-pickers-pro": "^9.18.0",
    "@mui/x-tree-view": "^9.18.0",
    "@mui/x-tree-view-pro": "^9.18.0",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsc-alias": "1.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
